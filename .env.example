# Copy to .env and change for anything beyond local dev
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
WAREHOUSE_BUCKET=warehouse
EXPORTS_BUCKET=exports
# Comma-separated "key:role". role "admin" sees unmasked PII, "analyst" sees masked values.
API_KEYS=dev-analyst-key:analyst,dev-admin-key:admin
# Host clients use this endpoint inside presigned URLs (must be reachable by whoever downloads)
S3_PUBLIC_ENDPOINT=http://localhost:9000
CACHE_TTL_SECONDS=300
